# Copy to secrets.properties (git-ignored) and fill in. Never commit the real file.
# Every line is optional: a feature without its value shows a short note instead. Rebuild after a change.

# Where the TV is, in decimal degrees. Weather (Open-Meteo, no account), the sky glows at sunrise and sunset.
# (Night mode's times are set on the TV: Launcher settings > Night mode.)
HOME_LATITUDE=
HOME_LONGITUDE=
# F or C (default F)
TEMPERATURE_UNIT=F

# Discogs: your username. The record picker uses your collection (it must be public, or add a token).
DISCOGS_USERNAME=
# Optional personal access token: discogs.com > Settings > Developers > Generate new token
DISCOGS_TOKEN=

# Scores (ESPN's public scoreboard feed, unofficial). One or more teams as sport/league/team, comma-separated.
# Examples: basketball/nba/bos, football/nfl/ne, baseball/mlb/bos, hockey/nhl/bos, football/college-football/333
# With several, Scores features whichever is in season (a game within 10 days), first in this order; between
# seasons, the one that starts soonest. E.g. football/nfl/chi,baseball/mlb/atl covers the year.
SCORES_TEAMS=
# Optional: conferences, as sport/league/group, each a card on More with its biggest games of the week:
# football/nfl/nfc, football/nfl/afc, football/college-football/sec (also acc, big-ten, big-12), or an ESPN
# group number. Your own teams in that league come first on the card.
SCORES_GROUPS=
# Optional: players to follow in individual sports, as sport/league/name, e.g. tennis/atp/Djokovic, tennis/wta/Gauff.
# Their live match also takes over the Home Scores chip. A tennis player also brings that tour's top matches of
# the day (the week's main tournament) into the "Around" row.
SCORES_PLAYERS=
# Optional: racing series, e.g. f1. "Around" shows the race weekend's latest session (top two), the result for
# three days after the race, otherwise the next race. A live race takes over the Home Scores chip.
SCORES_RACING=

# Picks for you: a free TMDB API key (themoviedb.org > Settings > API). The v3 key or the v4 read token both work.
TMDB_API_KEY=
# Two-letter country for "available on your services" (default US)
PICKS_REGION=US
# Which services Picks draws from, comma-separated, in order. Empty uses the ones installed on the TV.
# Names: netflix, prime, disney, max, hulu, appletv, peacock, paramount, youtube, plex, tubi, pluto, roku,
# kanopy, hoopla. (youtube, plex, tubi, pluto and roku are their free, ad-supported catalogs.)
PICKS_SERVICES=

# Jazz mode: Spotify playlist or album links, comma-separated (a line can end in \ to continue on the next).
# The first is the main one, opened by Open Spotify; the rest are the cards. Empty uses 11 built-in jazz playlists.
SPOTIFY_PLAYLISTS=

# Not used yet (Spotify playback control needs a Spotify developer app; Jazz mode opens Spotify instead).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=neonnoir://spotify-callback
