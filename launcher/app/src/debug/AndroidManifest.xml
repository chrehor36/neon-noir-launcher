<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: two fake TV inputs and a helper that fills them with test channels, so the Live guide can be
     tried on the emulator, which has no tuner. Run it with:
     adb shell am start -n io.github.chrehor36.neonnoir/.DemoChannelsActivity -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <application>
        <service
            android:name=".DemoTvInputService$Antenna"
            android:label="Antenna (test)"
            android:permission="android.permission.BIND_TV_INPUT"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data android:name="android.media.tv.input" android:resource="@xml/demo_tv_input" />
        </service>
        <service
            android:name=".DemoTvInputService$Free"
            android:label="Free channels (test)"
            android:permission="android.permission.BIND_TV_INPUT"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data android:name="android.media.tv.input" android:resource="@xml/demo_tv_input" />
        </service>
        <activity
            android:name=".DemoChannelsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
